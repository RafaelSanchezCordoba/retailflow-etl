POSTGRES_USER=retailflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=retailflow
POSTGRES_PORT=5432

# Airflow (Stage 3). Generate your own locally, do not reuse these placeholders:
#   FERNET_KEY: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   JWT_SECRET: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me

# AWS S3 raw zone (Stage 4). Credentials belong to the least-privilege
# "retailflow-app" IAM user created by infrastructure/terraform, scoped only
# to the retailflow-raw-<account_id> bucket. Generate your own:
#   aws iam create-access-key --user-name retailflow-app
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=eu-north-1
RAW_BUCKET_NAME=retailflow-raw-change_me